    <!-- ============================================================
         🚀 JAVASCRIPT KHUSUS DIAGRAM
         ============================================================ -->
    <script>
        // ============================================================
        // 🔧 KONFIGURASI - GANTI DENGAN ID SPREADSHEET ANDA
        // ============================================================
        const SPREADSHEET_ID = '2PACX-...'; // Ganti dengan ID Anda

        // 📊 KONFIGURASI DIAGRAM
        const CHART_SPREADSHEET_ID = SPREADSHEET_ID; // Ganti jika spreadsheet berbeda
        const CHART_SHEET_NAME = 'Capaian'; // Nama sheet untuk data capaian
        const CHART_SHEET_URL = `https://docs.google.com/spreadsheets/d/e/${CHART_SPREADSHEET_ID}/pub?gid=0&single=true&output=csv`;

        // Kolom-kolom yang akan ditampilkan di diagram
        const CHART_COLUMNS = [
            { key: 'tasmi_1_juz_muqorror', label: 'Tasmi 1 Juz (MuqorroR)' },
            { key: 'tasmi_1_juz_luar', label: 'Tasmi 1 Juz (Luar)' },
            { key: 'tasmi_setengah_juz', label: 'Tasmi 1/2 Juz' },
            { key: 'tasmi_3_juz', label: 'Tasmi 3 Juz' },
            { key: 'tasmi_5_juz', label: 'Tasmi 5 Juz' },
            { key: 'sertifikat_penggabungan', label: 'Sertifikat Penggabungan' },
            { key: 'setoran_10_20_30', label: 'Setoran 10, 20, 30 Juz' },
            { key: 'tasmi_30_juz', label: 'Tasmi 30 Juz Sekali Duduk' }
        ];

        // ============================================================
        // 📌 FUNGSI MODAL (salin dari kode sebelumnya)
        // ============================================================
        // ...

        // ============================================================
        // 📊 DIAGRAM - AMBIL DATA CAPAIAN DARI GOOGLE SHEETS
        // ============================================================
        let tasmiChart = null;
        let chartData = [];
        let chartLembagaList = [];

        function findHeaderIndex(headers, possibleNames) {
            for (const name of possibleNames) {
                const idx = headers.findIndex(h => h.toLowerCase().trim() === name.toLowerCase().trim());
                if (idx !== -1) return idx;
            }
            return -1;
        }

        async function loadChartData() {
            try {
                console.log('🔄 Mencoba mengambil data capaian dari:', CHART_SHEET_URL);
                
                const response = await fetch(CHART_SHEET_URL);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const csvText = await response.text();
                const lines = csvText.split('\n').filter(line => line.trim() !== '');
                console.log('📊 Jumlah baris capaian:', lines.length);
                
                if (lines.length < 2) {
                    console.warn('Data capaian kosong atau belum tersedia.');
                    return;
                }

                let headers = lines[0].split(',').map(h => h.trim().replace(/^"|"$/g, ''));
                console.log('📋 Header capaian:', headers);

                const lembagaIndex = findHeaderIndex(headers, ['LEMBAGA', 'Lembaga', 'lembaga']);

                const columnIndices = [];
                const columnLabels = [];

                for (const col of CHART_COLUMNS) {
                    const possibleNames = [
                        col.label,
                        col.label.toUpperCase(),
                        col.label.toLowerCase(),
                        col.key,
                        col.key.replace(/_/g, ' '),
                        col.key.replace(/_/g, ' ').toUpperCase(),
                        col.key.replace(/_/g, ' ').toLowerCase()
                    ];
                    
                    const idx = findHeaderIndex(headers, possibleNames);
                    if (idx !== -1) {
                        columnIndices.push(idx);
                        columnLabels.push(col.label);
                    } else {
                        console.warn(`Kolom "${col.label}" tidak ditemukan di data.`);
                    }
                }

                if (lembagaIndex === -1 || columnIndices.length === 0) {
                    console.warn('Kolom yang diperlukan tidak ditemukan di data.');
                    return;
                }

                chartData = [];
                chartLembagaList = [];

                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(',').map(c => c.trim().replace(/^"|"$/g, ''));
                    const lembaga = cols[lembagaIndex] || '';
                    if (!lembaga) continue;

                    const values = columnIndices.map(idx => {
                        const val = parseFloat(cols[idx]);
                        return isNaN(val) ? 0 : val;
                    });

                    chartData.push({ lembaga, values });
                    chartLembagaList.push(lembaga);
                }

                console.log(`📊 Data capaian: ${chartData.length} lembaga, ${columnLabels.length} jenis capaian`);

                updateLembagaDropdown();
                if (chartData.length > 0) {
                    renderChart(chartData[0], columnLabels);
                }

            } catch (error) {
                console.error('❌ Error loading chart data:', error);
            }
        }

        function updateLembagaDropdown() {
            const select = document.getElementById('chartLembagaSelect');
            select.innerHTML = '<option value="">-- Pilih Lembaga --</option>';
            
            chartLembagaList.forEach((lembaga, index) => {
                const option = document.createElement('option');
                option.value = index;
                option.textContent = lembaga;
                select.appendChild(option);
            });
        }

        function renderChart(data, columnLabels) {
            const ctx = document.getElementById('tasmiChart').getContext('2d');
            
            if (tasmiChart) {
                tasmiChart.destroy();
            }

            const colors = [
                'rgba(26, 77, 46, 0.85)', 'rgba(45, 106, 79, 0.85)',
                'rgba(201, 168, 76, 0.85)', 'rgba(232, 212, 139, 0.85)',
                'rgba(26, 77, 46, 0.6)', 'rgba(45, 106, 79, 0.6)',
                'rgba(201, 168, 76, 0.6)', 'rgba(232, 212, 139, 0.6)'
            ];

            const borderColors = [
                'rgba(26, 77, 46, 1)', 'rgba(45, 106, 79, 1)',
                'rgba(201, 168, 76, 1)', 'rgba(232, 212, 139, 1)',
                'rgba(26, 77, 46, 1)', 'rgba(45, 106, 79, 1)',
                'rgba(201, 168, 76, 1)', 'rgba(232, 212, 139, 1)'
            ];

            tasmiChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: columnLabels,
                    datasets: [{
                        label: `${data.lembaga} - Capaian Tasmi'`,
                        data: data.values,
                        backgroundColor: colors.slice(0, data.values.length),
                        borderColor: borderColors.slice(0, data.values.length),
                        borderWidth: 2,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            labels: { color: '#1a4d2e', font: { size: 12, weight: '600' } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.label}: ${context.raw}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { color: '#1a4d2e', font: { size: 11 } },
                            grid: { color: 'rgba(201, 168, 76, 0.1)' }
                        },
                        x: {
                            ticks: { color: '#1a4d2e', font: { size: 10 }, maxRotation: 45, minRotation: 0 },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // Event listener untuk dropdown
        document.getElementById('chartLembagaSelect').addEventListener('change', function() {
            const index = parseInt(this.value);
            if (isNaN(index) || index < 0 || index >= chartData.length) return;
            if (tasmiChart) {
                renderChart(chartData[index], tasmiChart.data.labels);
            }
        });

        document.getElementById('chartRefreshBtn').addEventListener('click', function() {
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memuat...';
            this.disabled = true;
            loadChartData().then(() => {
                this.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh Data';
                this.disabled = false;
            });
        });

        // ============================================================
        // 💬 WHATSAPP FLOATING BUTTON (salin dari kode sebelumnya)
        // ============================================================
        // ...

        // ============================================================
        // 🚀 LOAD DATA SAAT HALAMAN DIMUAT
        // ============================================================
        document.addEventListener('DOMContentLoaded', loadChartData);
        console.log('🌙 HAFZApp - Halaman Diagram — Barakallah!');
    </script>
